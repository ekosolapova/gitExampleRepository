<project>
    <name>AAEB GPLW Rating</name>
    <modules>
        <module>
            <rules-root path="rules/*.xlsx"/>
            <method-filter>
                <includes>
                    <value>.+ AgeBandsList\(\)</value>
                    <value>.+ PolicyOverrideCalculation\(.+\)</value>
                    <value>.+ getTestDataForJSON\(\)</value>
                    <value>.+ MemberPremium\(.+\)</value>
                    <value>.+ PolicyCalculation\(.+\)</value>
                </includes>
            </method-filter>
        </module>
    </modules>
    <classpath>
        <entry path="groovy"/>
        <entry path="lib/*.jar"/>
    </classpath>
    <properties-file-name-pattern>.*-%state%-%effectiveDate%-%startRequestDate%</properties-file-name-pattern>
    <properties-file-name-pattern>.*Tests</properties-file-name-pattern>
    <properties-file-name-pattern>.*Model</properties-file-name-pattern>
</project>
